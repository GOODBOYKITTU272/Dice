# DicePilot Supabase project (pkuqcnvtweukgurisczw) — separate from the
# existing Indeed Supabase project used by main.py.
#
# SUPABASE_SERVICE_ROLE_KEY is server-side only: backend/worker/test code.
# Never expose it to frontend/browser code, never commit a real value.
# If a browser-facing Supabase client is introduced later it needs its own
# SUPABASE_ANON_KEY (not defined yet — no browser-facing client exists).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Existing ApplyWizz candidate-details API (02_ApplyWizz_DicePilot_TRD.pdf
# section 12) — required by dice/candidate_adapter.py. Not yet configured
# anywhere in this project as of Phase 4E; live validation of the adapter
# is blocked until these are set to real values (never commit real values).
APPLYWIZZ_API_BASE_URL=
APPLYWIZZ_API_TOKEN=

# The candidate_id local_app/app.py enqueues applications and starts
# worker runs for. Not a secret, but never hardcoded in application code
# either (Phase 6.2) -- required for Jobs "Apply to Selected Jobs" and the
# Candidate page; without it, both show a clear configuration error
# rather than falling back to a guessed/historical id.
DICEPILOT_CANDIDATE_ID=

# Optional: REQUIRE_CONFIRMATION or AUTHORIZED_AUTONOMOUS. Resolved once,
# at the moment a run is created via "Start Applications" -- never read
# again after that (Phase 6.4). Unset defaults to AUTHORIZED_AUTONOMOUS,
# this project's intended normal mode. Set to REQUIRE_CONFIRMATION for
# manual/debug runs that should stop at Review instead of auto-submitting.
DICEPILOT_SUBMISSION_MODE=

# dice_browser.worker_daemon's CDP attach target (Phase 7.1 -- cloud
# worker migration). Only ever same-host in practice, whether that host
# is a local Mac or a cloud VM: the daemon and the browser it attaches to
# always run side by side. Unset defaults to http://127.0.0.1:9333.
DICEPILOT_CDP_URL=

# Root directory for the persistent Chromium user-data-dir dice_browser.
# session's launch_persistent_session() uses (Phase 7.1). Must be on
# durable disk that survives worker restarts and VM reboots -- never
# ephemeral /tmp. Unset defaults to .runtime/browser_profiles/ under the
# repo root, which is fine for local dev but NOT durable on most cloud
# VMs' default disk layout; set explicitly for a cloud deployment (e.g.
# /opt/dicepilot/browser-profile -- see deploy/cloud-worker/README.md).
DICEPILOT_BROWSER_PROFILE_DIR=

# local or steel (Phase 7.2). Unset defaults to local -- an
# already-running, human-authenticated Chrome DicePilot only ever
# CDP-attaches to, never launches or owns. steel uses a self-hosted
# Steel Browser (github.com/steel-dev/steel-browser) service instead --
# same connect_over_cdp() call, confirmed unmodified during the Steel
# compatibility spike (2026-08-23) -- and additionally clears Chrome's
# own stale SingletonLock/SingletonCookie/SingletonSocket artifacts at
# worker startup (see dice_browser.session.clean_stale_singleton_locks),
# which a Steel container recreation can otherwise leave behind. For
# steel mode, DICEPILOT_CDP_URL should point at Steel's ws:// endpoint
# and DICEPILOT_BROWSER_PROFILE_DIR at the same durable path Steel's own
# CHROME_USER_DATA_DIR is configured with -- see
# deploy/cloud-worker/README.md.
DICEPILOT_BROWSER_PROVIDER=

# Steel's own API base URL (Phase 7.3 -- session recovery), used to check
# API health and create/reuse sessions automatically without a human
# opening the Steel viewer first. Unset derives it from DICEPILOT_CDP_URL
# (ws://host:port -> http://host:port), which is correct for a normal
# single-service Steel deployment; only set this explicitly if the API
# and the CDP endpoint are fronted separately.
STEEL_BASE_URL=

# Phase 7.7: absolute path to the candidate's resume file, read by the
# deployed worker daemon (dicepilot-worker.service passes no CLI flags,
# so this env var is the only way production ever gets one -- a real,
# live-verified gap before this existed: the daemon started fine with no
# resume configured and only failed hours later, mid-application,
# instead of at startup). --resume-path overrides this for a one-off
# local/debug invocation; leave that unset in production.
DICEPILOT_RESUME_PATH=

# Phase 7.9: Browserless (DICEPILOT_BROWSER_PROVIDER=browserless) -- the
# only real secret is BROWSERLESS_TOKEN. Unlike steel/local,
# DICEPILOT_CDP_URL is NOT used for this provider -- the worker creates
# a brand-new Browserless session itself on every connect (never a
# static, manually-copied session URL, which goes stale and needs a
# human to notice). BROWSERLESS_REGION defaults to production-sfo;
# only set it if you're on a different regional endpoint.
BROWSERLESS_TOKEN=
BROWSERLESS_REGION=

# The candidate's persisted Dice login, as JSON -- exported once via the
# manual Cookie-Editor procedure (see deploy/cloud-worker/README.md),
# loaded into every fresh Browserless session before any navigation.
# Known V1 limitation: Browserless's free tier has no interactive
# re-login flow, so when Dice itself invalidates this, a human must
# manually re-export it and update this value -- the worker never
# guesses, bypasses, or crashes over a missing/expired value, it just
# surfaces AUTH_REQUIRED like any other unauthenticated session. Never
# commit a real value here.
DICE_AUTH_COOKIES_JSON=

# Phase 7.4: Apply/Skip/Confirm/Edit messaging flow (attention/). Both
# channels are optional and independent -- the worker daemon sends
# notifications through whichever of these are configured (none, either,
# or both); with neither set, the Apply/Skip flow simply has no
# messaging channel to notify through yet.

# Telegram (primary V1 channel). Create a bot via @BotFather to get
# TELEGRAM_BOT_TOKEN -- the only real secret; keep it out of git/logs.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID / IMESSAGE_CONTACT below are dev-only fallback
# destinations, used solely when no candidate_attention_channels row is
# bound (e.g. quick local testing without running the link-code flow).
# Phase 7.5: the real, durable candidate<->channel identity lives in the
# candidate_attention_channels table (attention/channels.py), populated
# by a one-time link-code flow (create_link_code/consume_link_code) --
# never by editing these env vars per candidate. Every real send goes
# through attention/routing.py, which looks up the candidate's bound
# chat_id/contact from that table and passes it to the provider
# constructor, overriding these defaults.
TELEGRAM_CHAT_ID=

# iMessage (secondary V1 channel). Sending uses AppleScript to drive
# Messages.app (requires one-time macOS Automation permission, granted
# interactively); reading uses a read-only query against the local
# ~/Library/Messages/chat.db. Only works when the worker daemon runs on
# a Mac that's actually signed into that iMessage account.
IMESSAGE_CONTACT=
